{
  "name": "hobbies-collection",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm run build:packages && pnpm run build:apps",
    "build:apps": "pnpm -r --filter \"./apps/*\" run build",
    "build:packages": "pnpm -r --filter \"./packages/*\" run build",
    "build:api": "pnpm run build:packages && pnpm --filter @hobbies-collection/api build",
    "db:start": "docker compose up database -d",
    "db:init": "pnpm db:init:empty && pnpm --filter @hobbies-collection/api run db:seed",
    "db:init:empty": "pnpm --filter @hobbies-collection/api run db:migrate",
    "dev": "pnpm run -r --parallel --aggregate-output dev",
    "typecheck": "pnpm run build:packages && pnpm run -r typecheck"
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "eslint": "^9.36.0",
    "typescript-eslint": "^8.44.0"
  },
  "author": "Andrii Kotliar",
  "repository": {
    "type": "git",
    "url": "https://github.com/andrikotliar/hobbies-collection"
  }
}